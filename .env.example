# Database connection
# For Supabase:
#   DATABASE_URL = Transaction/Pooler connection (port 6543) for runtime
#   DIRECT_URL   = Direct connection (port 5432) for migrations
# IMPORTANT: URL-encode special chars in password (= → %3D, @ → %40, # → %23)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Admin Session
JWT_SECRET="your_jwt_secret_key_here"

# Gemini API Key (Optional: falling back to mock agent if empty)
GEMINI_API_KEY=""

# Base URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Microsoft Azure Cognitive Speech (Bilingual TTS)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"

# OpenAI API Key (Optional fallback for TTS)
OPENAI_API_KEY=""

# Google Analytics 4 Measurement ID (Optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
